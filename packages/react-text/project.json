{
  "name": "react-text",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react-text/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project react-text --web",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/react-text",
        "main": "packages/react-text/src/index.ts",
        "tsConfig": "packages/react-text/tsconfig.lib.json",
        "skipTypeCheck": true
      }
    }
  }
}
